<%
  index_title = 'Carl Wiedemann'
-%>
<!DOCTYPE html>
<html lang="en-us">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="google-site-verification" content="mvYev_JUFUYr2v1J05_vG1_3bI6z5loefhSu-h5OrLk">
  <title><%= @title ? "#{@title} - #{index_title}" : index_title %></title>
  <link rel="alternate" type="application/rss+xml" title="<%= index_title %>" href="/feed.xml">
  <link rel="stylesheet" href="https://use.typekit.net/lcc4etk.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet">
  <style>

      /* ########## */
      /* SITE TITLE */
      /* ########## */

      /*Abril Fatface Italic*/
      /*font-family: abril-fatface, serif;*/
      /*font-weight: 400;*/
      /*font-style: italic;*/

      /* ######### */
      /* BODY TEXT */
      /* ######### */

      /*Atkinson Hyperlgible regular*/
      /*font-family: "Atkinson Hyperlegible", sans-serif;*/
      /*font-weight: 400;*/
      /*font-style: normal;*/

      /*Atkinson Hyperlgible bold*/
      /*font-family: "Atkinson Hyperlegible", sans-serif;*/
      /*font-weight: 700;*/
      /*font-style: normal;*/

      /*Atkinson Hyperlgible italic*/
      /*font-family: "Atkinson Hyperlegible", sans-serif;*/
      /*font-weight: 400;*/
      /*font-style: italic;*/

      /*Atkinson Hyperlgible bold italic*/
      /*font-family: "Atkinson Hyperlegible", sans-serif;*/
      /*font-weight: 700;*/
      /*font-style: italic;*/

      /* ########### */
      /* CODE BLOCKS */
      /* ########### */

      /*Fira Mono Regular*/
      /*font-family: fira-mono, monospace;*/
      /*font-weight: 400;*/
      /*font-style: normal;*/

      /*Fira Mono Bold*/
      /*font-family: fira-mono, monospace;*/
      /*font-weight: 700;*/
      /*font-style: normal;*/

      :root {
          --rhythm: 0.75rem;                 /* base grid unit: 12px */
          --line: calc(var(--rhythm) * 2);   /* one line of body text: 24px */
      }

      html {
          box-sizing: border-box;
      }

      *, *:before, *:after {
          box-sizing: inherit;
      }

      body {
          font-family: "Atkinson Hyperlegible", sans-serif;
          font-weight: 400;
          font-style: normal;
          font-size: 1rem;
          line-height: var(--line);
          margin: 0;
          padding: 0;
      }

      h1.title {
          font-family: abril-fatface, serif;
          font-weight: 400;
          font-style: italic;
          line-height: calc(var(--rhythm) * 4);   /* 48px */
          margin: 0;
          word-wrap: break-word;
      }

      h1.title a {
          color: inherit;
      }

      h1.title a:hover {
          color: #FFF;
      }

      a:link,
      a:visited {
          color: #00F;
          text-decoration: none;
      }

      a:hover {
          background-color: #00F;
          color: #FFF;
      }

      main p a:hover code {
          background-color: #00F;
      }

      header,
      main,
      footer {
          margin: 0 auto;
          max-width: 1100px;
          padding: 0 1em;
      }

      main {
          margin-top: var(--line);
          margin-bottom: calc(var(--line) * 4);
      }

      nav ul {
          margin: 0;
          padding: 0;
          list-style: none;
      }

      nav li {
          display: inline;
      }

      /* Headings: line-heights are whole multiples of --rhythm,
         margins are whole multiples of --line */
      h1, h2, h3, h4 {
          font-weight: 700;
          font-style: normal;
          opacity: 0.9;
          margin: calc(var(--line) * 2) 0 var(--line);
      }

      h1 {
          font-size: 2rem;
          line-height: calc(var(--rhythm) * 4);   /* 48px */
      }

      h2 {
          font-size: 1.5rem;
          line-height: calc(var(--rhythm) * 3);   /* 36px */
      }

      h3 {
          font-size: 1.2rem;
          line-height: calc(var(--rhythm) * 2);   /* 24px */
      }

      h4 {
          font-size: 1rem;
          line-height: calc(var(--rhythm) * 2);   /* 24px */
      }

      main > h1:first-child {
          margin-top: 0;
      }

      main > p:last-child {
          margin-bottom: 0;
      }

      blockquote > p:last-child {
          margin-bottom: 0;
      }

      p,
      ul,
      ol {
          margin: 0 0 var(--line);
      }

      figure {
          margin: 0 0 var(--line);
          text-align: center;
      }

      figcaption,
      footer {
          font-style: italic;
          font-size: 0.9em;
          /* line-height is inherited as a fixed length, so rhythm is preserved */
      }

      main li {
          margin: var(--line) 0;
      }

      main code {
          font-family: fira-mono, monospace;
          line-height: 1;   /* stops the monospace font from stretching line boxes */
      }

      main p code,
      main li code,
      main h2 code,
      main h3 code {
          background-color: #f3f3f3;
          display: inline;
          width: auto;
          white-space: nowrap;
      }

      main img {
          max-width: 100%;
      }

      main blockquote {
          background-color: #EEE;
          opacity: 0.8;
          margin: 0 0 var(--line);
          padding: var(--line);
      }

      main > p:last-of-type:after {
          content: ' ∎';
          font-weight: 700;
      }

      .highlight {
          background-color: #FFFF00;
      }

      footer {
          margin: calc(var(--line) * 2) auto;
      }

      @media (prefers-color-scheme: dark) {
          body {
              background-color: #181818;
              color: #DDD;
          }

          img {
              opacity: .75;
              transition: opacity .5s ease-in-out;
          }

          img:hover {
              opacity: 1;
          }

          main blockquote {
              background-color: #000;
              opacity: 0.8;
          }

          a:link,
          a:visited {
              color: #9696FF;
              text-decoration: none;
          }

          a:hover {
              background-color: #00F;
              color: #FFF;
          }

          main p code,
          main li code,
          main h2 code,
          main h3 code {
              background-color: #383838;
          }

          .highlight {
              background-color: #494900;
              color: #EEE;
          }
      }

      /* ---------- Rhythm debugging overlay ----------
         Usage: <body class="rhythm"> */
      .rhythm {
          background-image:
              /* stronger line every full text line (2 units) */
                  linear-gradient(to bottom, transparent calc(100% - 1px), rgba(255, 0, 0, 0.35) 100%),
                      /* faint line every half-line unit */
                  linear-gradient(to bottom, transparent calc(100% - 1px), rgba(0, 150, 255, 0.25) 100%);
          background-size: 100% var(--line), 100% var(--rhythm); background-position: 0 0;
      }
  </style>
</head>
<body>
<header>
  <h1 class="title"><a href="/">Carl Wiedemann</a></h1>
  <nav>
    <ul>
      <li><a href="https://github.com/carlwiedemann">github</a></li>
      <li><a href="https://www.linkedin.com/in/carlwwiedemann">linkedin</a></li>
      <li><a href="https://twitter.com/carlwiedemann">twitter</a></li>
      <li><a href="https://bsky.app/profile/carlwiedemann.bsky.social">bluesky</a></li>
    </ul>
  </nav>
</header>
<main>
  <%= @content %>
</main>
<footer>
  <p>Powered by <a href="https://github.com/carlwiedemann/foresite">Foresite</a></p>
</footer>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/default.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/base16/solarized-dark.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
<script>hljs.highlightAll();</script>
</body>
</html>
